# log0 demo shop: where to ship logs (the log0 ingestion gateway) and with which API key
# local stack:   LOG0_URL=http://host.docker.internal:8080
# hosted tunnel: LOG0_URL=https://ingest.log0.in
LOG0_URL=http://host.docker.internal:8080
LOG0_API_KEY=paste-an-api-key-from-the-log0-console
LOG0_ENV=demo
